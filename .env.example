# =============================================================================
# MIGA — MCP Intelligence Gateway Architecture
# Environment Configuration Template
# Copy to .env and fill in your credentials:  cp .env.example .env
#
# NEVER commit real secrets. The server registry (config/server-registry.yaml)
# references only the env var NAMES below; values live here in .env.
# Every variable named in a registry `env_required` field is listed, grouped by
# platform. ${VAR} placeholders in the registry (e.g. the Splunk URL) are resolved
# from these values at gateway startup.
# =============================================================================

# -- MIGA Core ----------------------------------------------------------------
MIGA_ENV=development
MIGA_LOG_LEVEL=INFO
MIGA_GATEWAY_PORT=8000
MIGA_REDIS_URL=redis://redis:6379/0

# -- Microsoft Entra ID (Gateway JWT Auth) ------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=https://login.microsoftonline.com/${ENTRA_TENANT_ID}

# -- AGNTCY (Directory + Identity) --------------------------------------------
AGNTCY_DIRECTORY_URL=http://agntcy-directory:8500
AGNTCY_IDENTITY_ISSUER=miga
AGNTCY_IDENTITY_KEY_PATH=/run/secrets/agntcy_signing_key

# -- WebEx Bot (conversational interface — kept) ------------------------------
WEBEX_BOT_ACCESS_TOKEN=
WEBEX_BOT_NAME=MIGA
WEBEX_BOT_EMAIL=miga-bot@webex.bot
WEBEX_WEBHOOK_URL=https://your-public-url/webhooks/webex
WEBEX_API_BASE_URL=https://webexapis.com/v1

# =============================================================================
# Downstream MCP servers (credentials by platform)
# =============================================================================

# -- Cisco ThousandEyes (official, remote HTTP) -------------------------------
# Registry injects: Authorization: Bearer ${TE_TOKEN} to https://api.thousandeyes.com/mcp
# (Upstream proxy examples name this AUTH_TOKEN; TE_TOKEN is MIGA-side.)
TE_TOKEN=

# -- Splunk (official, remote HTTP inside the Splunk instance) ----------------
# URL is https://${SPLUNK_HOST}:8089/services/mcp ; Authorization: Bearer ${SPLUNK_TOKEN}
SPLUNK_HOST=your-splunk.example.com
SPLUNK_TOKEN=

# -- Cisco Meraki (CiscoDevNet community, HTTP :8000/mcp) ----------------------
MERAKI_API_KEY=
MERAKI_ORG_ID=

# -- Cisco Catalyst SD-WAN / vManage (CiscoDevNet community, docker stdio) -----
VMANAGE_HOST=your-vmanage.example.com
VMANAGE_PORT=443
VMANAGE_USERNAME=admin
VMANAGE_PASSWORD=

# -- Cisco Catalyst Center / DNA Center (community, stdio fastmcp) -------------
# NOTE: upstream env vars are CCC_* (NOT DNAC_*). CCC_HOST is a full URL.
CCC_HOST=https://your-catalyst-center.example.com
CCC_USER=admin
CCC_PWD=

# -- Cisco ISE (community, HTTP :8005/mcp) ------------------------------------
ISE_HOST=your-ise.example.com
ISE_USERNAME=
ISE_PASSWORD=
ISE_VERIFY_SSL=true

# -- ServiceNow ITSM (community: echelon-ai-labs/servicenow-mcp, stdio) --------
# Read/write upstream. Use a least-privilege account and restrict the tool surface
# with MCP_TOOL_PACKAGE (e.g. service_desk). AUTH_TYPE: basic | oauth | api_key.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_AUTH_TYPE=basic
MCP_TOOL_PACKAGE=service_desk

# -- NetBox (NetBox Labs official, read-only, HTTP :8000/mcp) ------------------
# NOTE: upstream env var is NETBOX_URL (not NETBOX_BASE_URL). Use a read-only token.
NETBOX_URL=https://your-netbox.example.com
NETBOX_TOKEN=

# -- INFER Engine (MIGA-original; no external creds) --------------------------
INFER_VECTOR_STORE_PATH=/data/infer/vectors
INFER_MODEL_CACHE_PATH=/data/infer/models
INFER_CORRELATION_WINDOW_SECONDS=300
INFER_ANOMALY_SENSITIVITY=0.85
